# Copy to .env.local and adjust. Every variable is optional.

# Overrides `site.url` in config/site.ts (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=

# Only for sub-path hosting such as https://<user>.github.io/<repo>. Leave empty otherwise.
NEXT_PUBLIC_BASE_PATH=

# Set to "true" to produce a static export in ./out (npm run build:static does this).
STATIC_EXPORT=
